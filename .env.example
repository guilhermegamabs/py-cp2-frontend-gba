# Copie para .env e ajuste. O .env NÃO é versionado; este arquivo sim.

# --- Banco (MySQL local) ----------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=root
DB_NAME=sensor_db

# --- API --------------------------------------------------------------------
# Origens autorizadas a consumir a API. Nunca `*`.
CORS_ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# --- Limiares de governança -------------------------------------------------
# Alterar aqui muda o veredito de conformidade do relatório, sem mexer em código.
SLO_MAX_FRESHNESS_SECONDS=120
SLO_MIN_COMPLETENESS_RATIO=0.80
SLO_MAX_LATENCY_MS=500
SLO_MIN_SUCCESS_RATIO=0.99
SLO_MIN_CONTEXT_COVERAGE=1.0

# --- Front ------------------------------------------------------------------
API_BASE_URL=http://localhost:8000/v1
REQUEST_TIMEOUT_SECONDS=10
